begin:
Using domain server:
generator: <<ok
!bash
echo "regexp: ^^ \"Name: $(config dns_host)\" \$\$"
echo "regexp: ^^ \"Address:\" \\s+ '$(config dns_host_ip)' \c[NUMBER SIGN] $(config dns_port) \$\$"
ok
Aliases: 
regexp: ^^ $$
generator: <<ok
!bash

echo "regexp: ^^ '$(config host)' \\s+ 'is an alias for' \\s+  $(config alias) '.' \$\$"
echo "regexp: ^^ \"$(config alias) has address $(config ip)\" \$\$"
ok
end:
